<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mars.Life.Simulations" Version="6.0.0" />
    <ProjectReference Include="..\Dungeon\Dungeon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
