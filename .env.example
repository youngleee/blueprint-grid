# Copy this file to .env (repository root or GridBlueprint/) and add your key.
# .env is ignored by git. Process environment variables take precedence.

# Dungeon experiment (Dungeon.Cli run)
DUNGEON_LLM_PROVIDER=openai            # openai | stub (offline, pipeline checks only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14   # pin a dated snapshot
OPENAI_TEMPERATURE=0
DUNGEON_LLM_CACHE=cache/llm            # record/replay cache directory

# Previous prototype (GridBlueprint) only
ADAPTIVE_LLM_PROVIDER=openai
